# ===========================================================================
# Medical image analysis project - git ignore rules
#
# Two things must never be committed:
#   1. patient data (even de-identified public datasets are usually
#      redistribution-restricted by their licence);
#   2. large binaries (model weights, checkpoints, prediction dumps).
# ===========================================================================

# --- virtual environments --------------------------------------------------
.venv/
venv/
env/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# --- Jupyter ---------------------------------------------------------------
.ipynb_checkpoints/

# --- DATA: never commit medical images -------------------------------------
#
# Note the `/**` rather than a plain `data/raw/`. Git will not descend into an
# excluded DIRECTORY, so a `!data/raw/.gitkeep` negation under `data/raw/` can
# never take effect. Excluding the directory CONTENTS instead, then re-including
# the directories themselves, is what makes the placeholder files below work.
data/raw/**
data/processed/**

# Re-include the directory entries so git descends into them...
!data/raw/**/
!data/processed/**/
# ...and keep the placeholder files (data/README.md is never ignored).
!data/raw/**/.gitkeep
!data/processed/**/.gitkeep

# Scratch data stages - no placeholders needed, so a plain directory rule is fine.
data/interim/
data/external/

# Course download cache (original Coursera archives). Keep local; never commit.
data_dl/

# --- medical image formats, anywhere in the tree ---------------------------
*.dcm
*.nii
*.nii.gz
*.mhd
*.raw

# --- MODELS & CHECKPOINTS: too large for git -------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.pkl
*.joblib
checkpoints/

# --- experiment tracking ---------------------------------------------------
runs/
wandb/
lightning_logs/
mlruns/

# --- outputs: drop the bulky artefacts, keep the report-worthy ones --------
# Predicted masks and array dumps are regenerated by notebook 06 on demand.
outputs/**/predictions/masks/
outputs/**/predictions/*.npy
outputs/**/predictions/*.npz

# `outputs/` itself is not ignored, so these stay tracked by default. The
# negations are explicit guards: they keep metrics, figures and run provenance
# committed even if a broader `outputs/` rule is added later. Model weights
# under outputs/ are still excluded by the *.pt / *.pth rules above.
!outputs/**/metrics/
!outputs/**/figures/
!outputs/**/config_used.yaml
!outputs/**/run_metadata.json

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- logs ------------------------------------------------------------------
*.log

# --- TensorFlow / Keras baseline artefacts (large or regenerable) -----------
# Keep report-worthy classification/segmentation notebooks outputs elsewhere
# tracked via the older !outputs/**/metrics|figures rules when applicable;
# these three trees are intentionally ignored for the TF baseline notebook.
outputs/models/
outputs/metrics/
outputs/figures/
